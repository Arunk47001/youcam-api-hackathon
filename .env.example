# Copy this file to .env.local and fill in real values. .env.local is gitignored.

# --- YouCam API (required for real calls) ---
# From https://yce.makeupar.com/api-console/en/api-keys/ after redeeming your hackathon code.
YOUCAM_API_KEY=

# Optional: only set this if your console also issued a Secret Key. When
# present, lib/youcam/client.ts uses it to RSA-sign a request for a
# short-lived access_token (the V1-style flow) instead of using
# YOUCAM_API_KEY directly as the bearer token (the simpler V2 flow). Leave
# blank unless you hit 401s with just the API key.
YOUCAM_API_SECRET=

# Base URL for the YouCam S2S REST API. Confirm the exact value (and the
# per-endpoint paths in lib/youcam/client.ts) against your API Playground —
# the public docs site is JS-rendered and this default is a best-effort guess
# from the published Quick Start flow.
YOUCAM_API_BASE_URL=https://yce-api-01.perfectcorp.com/s2s/v2.0

# Only used when YOUCAM_API_SECRET is set, to exchange a signed id_token for
# an access_token.
YOUCAM_AUTH_URL=https://yce-api-01.perfectcorp.com/s2s/v1.0/client/auth

# --- Optional: LLM-generated stylist rationale ---
# If unset, the app falls back to a templated (non-LLM) rationale so the demo
# still works with only a YouCam key.
ANTHROPIC_API_KEY=

# --- Local development without spending API units ---
# Set to 1 to use canned mock responses instead of calling YouCam for real.
# Great for building/demoing the UI before your API Playground fields are confirmed.
MOCK_YOUCAM=1

# Set to 1 to log the raw YouCam poll response for a skin-analysis task to
# the server console (see lib/youcam/skinAnalysis.ts). Useful when
# double-checking the results shape against a real account; noisy otherwise.
YOUCAM_DEBUG=0
